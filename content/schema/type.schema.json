{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bài học cho một dạng câu hỏi",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "lesson", "steps", "tips", "traps"],
  "properties": {
    "id": { "type": "string" },
    "lesson": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 20 } },
    "steps": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 10 } },
    "tips": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 10 } },
    "traps": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 10 } },
    "time": { "type": "string" }
  }
}
